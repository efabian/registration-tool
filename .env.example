# Copy this file to .env and fill in the real values before running locally.
# Never commit .env to source control.

# ── Server ────────────────────────────────────────────────────────────────────
PORT=8080

# ── Database ──────────────────────────────────────────────────────────────────
# NOTE: sslmode=disable is for LOCAL DEVELOPMENT ONLY.
# Use sslmode=require or sslmode=verify-full in production.
DATABASE_URL=postgres://reguser:regpass@localhost:5432/registration?sslmode=disable

# ── SMTP ──────────────────────────────────────────────────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=user@example.com
SMTP_PASS=smtp-password

# ── Email ─────────────────────────────────────────────────────────────────────
EMAIL_SENDER=noreply@example.com
EMAIL_BCC=bcc@example.com
EMAIL_BCC_NICK=Admin
EMAIL_SUBJECT=Registration Confirmation

# ── Admin ─────────────────────────────────────────────────────────────────────
ADMIN_PASSCODE=changeme

# ── Ping salt (used by /ping uptime endpoint) ─────────────────────────────────
# FIX C-3: was previously hardcoded in source. Generate a random string here.
PING_SALT=replace-with-a-random-secret-string

# ── Zoom – Monday ─────────────────────────────────────────────────────────────
ZOOM_MON_LINK=https://zoom.us/j/example
ZOOM_MON_MEET=123 456 7890
ZOOM_MON_PASS=password
ZOOM_MON_DATE=Monday, Jan 1
ZOOM_MON_QR=https://example.com/qr/mon.png

# ── Zoom – Tuesday ────────────────────────────────────────────────────────────
ZOOM_TUE_LINK=https://zoom.us/j/example
ZOOM_TUE_MEET=123 456 7890
ZOOM_TUE_PASS=password
ZOOM_TUE_DATE=Tuesday, Jan 2
ZOOM_TUE_QR=https://example.com/qr/tue.png

# ── Zoom – Wednesday ──────────────────────────────────────────────────────────
ZOOM_WED_LINK=https://zoom.us/j/example
ZOOM_WED_MEET=123 456 7890
ZOOM_WED_PASS=password
ZOOM_WED_DATE=Wednesday, Jan 3
ZOOM_WED_QR=https://example.com/qr/wed.png

# ── Zoom – Thursday ───────────────────────────────────────────────────────────
ZOOM_THU_LINK=https://zoom.us/j/example
ZOOM_THU_MEET=123 456 7890
ZOOM_THU_PASS=password
ZOOM_THU_DATE=Thursday, Jan 4
ZOOM_THU_QR=https://example.com/qr/thu.png

# ── Zoom – Friday ─────────────────────────────────────────────────────────────
ZOOM_FRI_LINK=https://zoom.us/j/example
ZOOM_FRI_MEET=123 456 7890
ZOOM_FRI_PASS=password
